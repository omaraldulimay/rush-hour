    {
      "type": "timeseries",
      "title": "Catalog cache hit ratio",
      "description": "From the application, so it works without the Redis exporter.",
      "targets": [
        {
          "expr": "sum(rate(catalog_cache_requests_total{result=\"hit\"}[$__rate_interval])) / sum(rate(catalog_cache_requests_total[$__rate_interval])) * 100",
